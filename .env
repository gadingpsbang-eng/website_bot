# ===== WA BRIDGE - contoh konfigurasi =====
# Salin file ini menjadi .env lalu sesuaikan.

# --- Server ---
NODE_ENV=development
PORT=3000

# Nama brand (tampil di seluruh halaman)
BRAND_NAME=WA Bridge
BRAND_TAGLINE=Nomor WhatsApp Anda, jadi bot sendiri.

# --- Keamanan (WAJIB diubah sebelum produksi) ---
# Buat string acak, misalnya: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
JWT_EXPIRE=7d
BCRYPT_ROUNDS=10

# --- Batas ---
MAX_BOTS_PER_USER=3
MAX_PAIRING_ATTEMPTS=6
PAIRING_CODE_TTL_MS=900000

# --- Akun admin pertama (dibuat otomatis) ---
ADMIN_EMAIL=admin@wabridge.id
ADMIN_PASSWORD=Admin123!

# --- Kontak publik / nomor admin ---
SUPPORT_NUMBER=6285134837596
SUPPORT_DISPLAY=+62 851-3483-7596
SUPPORT_NAME=Admin WA Bridge
SUPPORT_HOURS=Setiap hari, 09.00 - 21.00 WIB

# --- WhatsApp / Baileys ---
# WA_BROWSER=Ubuntu|Chrome|120.0.0
# AUTO_REPLY_ENABLED=true
# IGNORE_GROUPS=true
# RECONNECT_MAX_ATTEMPTS=6
# RECONNECT_DELAY_MS=5000
